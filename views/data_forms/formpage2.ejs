<!-- Page 2: Sampling Event -->
<template id="template-form-page2">
    <div class="form-page" id="form-page2" data-page="2">
        <h2 class="form-section-title">Sampling Event Information</h2>
        <div class="form-section">
            <div class="instruction">
                Please provide information about when and how you collected your sample.
            </div>
              <!-- Device Installation Period Question -->
               <div class="form-label" style="margin-bottom: 12px;">Did this sample come from a device that was installed for a period of time (with a start and end date)?</div>
            <div class="form-field">                            <div class="radio-group" style="margin-left: 20px;">
                    <div class="radio-option">
                        <input type="radio" id="device-period-no" name="device_installation_period" value="no" checked>
                        <label for="device-period-no">No - Single collection event</label>
                    </div>
                    <div class="radio-option">
                        <input type="radio" id="device-period-yes" name="device_installation_period" value="yes">
                        <label for="device-period-yes">Yes - Device was installed for a period of time</label>
                    </div>
                </div>
            </div>

            <!-- Start date: the radio selection controls only the user-facing label. -->
            <fieldset class="partial-date-fieldset" id="start-date-section">
                <legend class="form-label" id="start-date-legend">
                    Plastic Collection Date (<span class="required-marker">*</span>):
                </legend>
                <div class="partial-date-inputs" data-partial-date-prefix="start">
                    <label class="partial-date-part" for="start-year">
                        <span>Year <span class="required-marker">*</span></span>
                        <input type="number" name="start_year" id="start-year"
                               class="partial-date-year" min="1000" max="9999"
                               inputmode="numeric" placeholder="YYYY" autocomplete="off">
                    </label>
                    <label class="partial-date-part" for="start-month">
                        <span>Month (optional)</span>
                        <select name="start_month" id="start-month" class="partial-date-month">
                            <option value="">Unknown / not reported</option>
                            <option value="1">January</option>
                            <option value="2">February</option>
                            <option value="3">March</option>
                            <option value="4">April</option>
                            <option value="5">May</option>
                            <option value="6">June</option>
                            <option value="7">July</option>
                            <option value="8">August</option>
                            <option value="9">September</option>
                            <option value="10">October</option>
                            <option value="11">November</option>
                            <option value="12">December</option>
                        </select>
                    </label>
                    <label class="partial-date-part" for="start-day">
                        <span>Day (optional)</span>
                        <select name="start_day" id="start-day" class="partial-date-day" disabled>
                            <option value="">Unknown / not reported</option>
                        </select>
                    </label>
                </div>
                <small class="partial-date-help">Year is required. Leave Month or Day unknown when it was not reported.</small>
                <div class="partial-date-error" id="start-date-error" role="alert" aria-live="polite"></div>
            </fieldset>

            <!-- End date is required only for a device installation period. -->
            <fieldset class="partial-date-fieldset" id="device-period-section" style="display: none;">
                <legend class="form-label">
                    Device Removal/End Date (<span class="required-marker">*</span>):
                </legend>
                <div class="partial-date-inputs" data-partial-date-prefix="end">
                    <label class="partial-date-part" for="end-year">
                        <span>Year <span class="required-marker">*</span></span>
                        <input type="number" name="end_year" id="end-year"
                               class="partial-date-year" min="1000" max="9999"
                               inputmode="numeric" placeholder="YYYY" autocomplete="off">
                    </label>
                    <label class="partial-date-part" for="end-month">
                        <span>Month (optional)</span>
                        <select name="end_month" id="end-month" class="partial-date-month">
                            <option value="">Unknown / not reported</option>
                            <option value="1">January</option>
                            <option value="2">February</option>
                            <option value="3">March</option>
                            <option value="4">April</option>
                            <option value="5">May</option>
                            <option value="6">June</option>
                            <option value="7">July</option>
                            <option value="8">August</option>
                            <option value="9">September</option>
                            <option value="10">October</option>
                            <option value="11">November</option>
                            <option value="12">December</option>
                        </select>
                    </label>
                    <label class="partial-date-part" for="end-day">
                        <span>Day (optional)</span>
                        <select name="end_day" id="end-day" class="partial-date-day" disabled>
                            <option value="">Unknown / not reported</option>
                        </select>
                    </label>
                </div>
                <small class="partial-date-help">Year is required. Leave Month or Day unknown when it was not reported.</small>
                <div class="partial-date-error" id="end-date-error" role="alert" aria-live="polite"></div>
            </fieldset>
              <div class="form-field">
                <div class="form-label">Collection Time (optional):</div>
                <div>
                    <input type="time" name="sample_time" class="time-input-wide" id="sample-time">
                </div>
            </div>

            <div class="form-field">
                <div class="form-label">Sample Description (optional):</div>
                <div>
                    <textarea name="sample_description" class="form-textarea-wide" id="sample-description" placeholder="Brief description of your sampling event..." rows="2"></textarea>
                </div>
            </div>

            <!-- Data source (mandatory for new samples). The eight source types
                 and their rules come from DataSourceTypeReference via
                 /api/references; the rules are shared with the API in
                 public/js/publication-form-utils.js. -->
            <div class="publication-source-section data-source-section" id="publication-source-section">
                <h3 class="section-subtitle">Data Source (<span class="required-marker">*</span>)</h3>
                <p class="instruction">
                    Every sample must name where its data came from. Reuse one of your previous
                    data sources, or choose a source type and describe a new one.
                </p>
                <div class="data-source-legacy-notice" id="data-source-legacy-notice" role="status" hidden>
                    This sample was saved before a data source was required. You can still save other changes;
                    please add its data source when you can.
                </div>

                <div class="form-row">
                    <label class="form-label" for="data-source-id">Select Existing Data Source:</label>
                    <div class="publication-field-control">
                        <select name="data_source_id" id="data-source-id"
                                class="form-select publication-select"
                                aria-describedby="data-source-select-help">
                            <option value="">-- Enter a new data source --</option>
                        </select>
                        <small id="data-source-select-help" class="help-text publication-help-text">
                            Lists the data sources you entered before. Choosing one fills in and locks the fields below;
                            choose &ldquo;Enter a new data source&rdquo; to unlock them and enter a new one.
                        </small>
                    </div>
                </div>

                <h4 class="data-source-step">Step 1: Source type</h4>
                <div class="form-row">
                    <label class="form-label" for="data-source-type-id">Data Source Type (<span class="required-marker">*</span>):</label>
                    <div class="publication-field-control">
                        <select id="data-source-type-id" name="data_source_type_id"
                                class="form-select publication-source-select publication-detail-field"
                                aria-describedby="data-source-type-help">
                            <option value="">-- Select Source Type --</option>
                        </select>
                        <small id="data-source-type-help" class="help-text publication-help-text">
                            Published sources (journal articles, books, reports, public databases) need a publication year;
                            unpublished data (research, agency, community, citizen-science) does not have one.
                        </small>
                    </div>
                </div>

                <div id="data-source-detail-fields" hidden>
                    <h4 class="data-source-step">Step 2: Source details</h4>
                    <div class="form-row">
                        <label class="form-label" for="source-title">Source Title (<span class="required-marker">*</span>):</label>
                        <div class="publication-field-control">
                            <input type="text" id="source-title" name="source_title" maxlength="500"
                                   class="form-input publication-detail-field"
                                   placeholder="e.g., Microplastics in Great Lakes Tributaries"
                                   aria-describedby="source-title-help">
                            <small id="source-title-help" class="help-text publication-help-text">
                                Title of the article, book, report, dataset, or project.
                            </small>
                        </div>
                    </div>
                    <div class="form-row">
                        <label class="form-label" for="authors-or-organization">Authors or Organization (<span class="required-marker">*</span>):</label>
                        <div class="publication-field-control">
                            <input type="text" id="authors-or-organization" name="authors_or_organization"
                                   class="form-input publication-detail-field"
                                   placeholder="Allen Smith; Maria Chen  or  Michigan Environmental Agency"
                                   aria-describedby="authors-or-organization-help">
                            <small id="authors-or-organization-help" class="help-text publication-help-text">
                                Enter author names in the same order as they appear in the source, using the format First Last
                                (e.g., Allen Smith), separated by semicolons; or the responsible organization, group, or program.
                            </small>
                        </div>
                    </div>
                    <div class="form-row" id="publication-year-row" hidden>
                        <label class="form-label" for="publication-year">Publication Year (<span class="required-marker">*</span>):</label>
                        <input type="number" id="publication-year" name="publication_year"
                               class="form-input publication-detail-field" min="1900"
                               inputmode="numeric" placeholder="YYYY">
                    </div>
                    <div class="form-row" id="date-accessed-row" hidden>
                        <label class="form-label" for="date-accessed">Date Accessed (<span class="required-marker">*</span>):</label>
                        <div class="publication-field-control">
                            <input type="date" id="date-accessed" name="date_accessed"
                                   class="form-input publication-detail-field"
                                   aria-describedby="date-accessed-help">
                            <small id="date-accessed-help" class="help-text publication-help-text">
                                The date you accessed the database or repository.
                            </small>
                        </div>
                    </div>
                    <div class="form-row">
                        <label class="form-label" for="journal-publisher-or-repository">Journal, Publisher, or Repository (<span class="required-marker">*</span>):</label>
                        <input type="text" id="journal-publisher-or-repository" name="journal_publisher_or_repository"
                               class="form-input publication-detail-field"
                               placeholder="Journal, publisher, agency, institution, or data repository">
                    </div>
                    <div class="form-row">
                        <label class="form-label" for="source-identifier-or-url">Identifier or URL:</label>
                        <input type="text" id="source-identifier-or-url" name="source_identifier_or_url" maxlength="500"
                               class="form-input publication-detail-field"
                               placeholder="DOI, ISBN, report number, dataset ID, or URL">
                    </div>
                    <div class="form-row">
                        <label class="form-label" for="project-or-collection-name">Project or Collection Name:</label>
                        <input type="text" id="project-or-collection-name" name="project_or_collection_name" maxlength="255"
                               class="form-input publication-detail-field"
                               placeholder="Associated monitoring program, project, or collection">
                    </div>
                    <div class="form-row">
                        <label class="form-label" for="citation-text">Full Citation (APA) (<span class="required-marker">*</span>):</label>
                        <textarea id="citation-text" name="citation_text"
                                  class="form-textarea publication-detail-field" rows="3"
                                  placeholder="Complete APA-style citation"></textarea>
                    </div>
                </div>
            </div>
        </div>
        <!-- Weather section - Always shown when additional info is yes -->
                <div class="info-section" id="weather-section">
                    <h3 class="section-subtitle">Weather</h3>
                    <div class="form-row">
                        <label class="form-label">Air Temp (C):</label>
                        <input type="number" step="0.000001" min="-999999.999999" max="999999.999999" name="air_temp" class="form-input" placeholder="Enter temperature">
                    </div>
                    <div class="form-row">
                        <label class="form-label">Weather Conditions at Time of Sampling:</label>
                        <select name="current_conditions" class="form-select">
                            <option value="">-- Select --</option>
                            <option value="Sunny">Sunny</option>
                            <option value="Cloudy">Cloudy</option>
                            <option value="Raining">Raining</option>
                        </select>
                    </div>
                    <div class="form-row">
                        <label class="form-label">Precedent 24-hour cm of rainfall:</label>
                        <input type="number" step="0.000001" min="0" max="999999.999999" name="rainfall" class="form-input" placeholder="Enter rainfall">
                    </div>
                </div>
        <div class="form-navigation">
            <button type="button" id="page2-continue" class="btn-continue" data-next="3">Continue</button>
        </div>
    </div>
</template>
