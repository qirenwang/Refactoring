<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile - Microplastics Data Entry</title>
    <link rel="icon" href="/assets/mpicon.ico" sizes="64x64">
    <!-- Add Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Add Custom CSS -->
    <link rel="stylesheet" href="/css/mp_style.css">
    <!-- Add Fancy Modal CSS -->
    <link rel="stylesheet" href="/css/fancy-modal.css">
    <!-- Add Custom JS -->
    <script src="/js/common.js"></script>
    
    <!-- Stagewise Toolbar for Development -->
    <% if (process.env.NODE_ENV !== 'production') { %>
        <script src="/js/stagewise-toolbar.js"></script>
    <% } %>
</head>
<body>
<div class="container">
    <%- include('partials/header') %>
    
    <div class="content">
        <%- include('partials/sidebar') %>
        
        <div class="main-content">
            <div class="profile-container">
                <h1 class="page-title">
                    <i class="fas fa-user"></i>
                    My Profile
                </h1>
                
                <div class="profile-content">
                    <!-- Success/Error Messages -->
                    <% if (typeof success !== 'undefined' && success) { %>
                        <div class="alert alert-success">
                            <i class="fas fa-check-circle"></i>
                            Profile updated successfully!
                        </div>
                    <% } %>
                    
                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-error">
                            <i class="fas fa-exclamation-circle"></i>
                            <%= error %>
                        </div>
                    <% } %>
                    
                    <% if (locals.profileEditable === false) { %>
                        <div class="profile-section" role="status">
                            <p>Your saved account information has not been changed.</p>
                            <dl class="account-info">
                                <dt>Username</dt>
                                <dd><%= user.username || '' %></dd>
                                <dt>Email</dt>
                                <dd><%= user.email || '' %></dd>
                                <dt>Name</dt>
                                <dd><%= [user.first_name, user.last_name].filter(Boolean).join(' ') || 'Not provided' %></dd>
                                <dt>Organization</dt>
                                <dd><%= user.organization || 'Not provided' %></dd>
                                <dt>Job / Position Title</dt>
                                <dd><%= user.job_title || 'Not provided' %></dd>
                            </dl>
                            <a class="btn-primary" href="/my-profile">Retry loading profile</a>
                        </div>
                    <% } else { %>
                    <form id="profile-form" method="POST" action="/my-profile">
                        <!-- Basic Information Section -->
                        <div class="profile-section">
                            <h2 class="section-title">
                                <i class="fas fa-user-circle"></i>
                                Basic Information
                            </h2>
                            <p class="form-help">
                                All profile fields are required. State is required only for United States.
                            </p>
                            
                            <div class="form-grid">
                                <div class="form-group">
                                    <label for="username" class="form-label">
                                        <i class="fas fa-user"></i>
                                        Username
                                    </label>
                                    <input type="text" id="username" name="username" class="form-input" 
                                           value="<%= user.username %>" readonly>
                                    <small class="form-help">Username cannot be changed</small>
                                </div>

                                <div class="form-group">
                                    <label for="email" class="form-label">
                                        <i class="fas fa-envelope"></i>
                                        Email Address *
                                    </label>
                                    <input type="email" id="email" name="email" class="form-input"
                                           value="<%= user.email || '' %>" maxlength="100"
                                           autocomplete="email" required>
                                </div>

                                <div class="form-group">
                                    <label for="first_name" class="form-label">
                                        <i class="fas fa-id-card"></i>
                                        First Name *
                                    </label>
                                    <input type="text" id="first_name" name="first_name" class="form-input"
                                           value="<%= user.first_name || '' %>" maxlength="50"
                                           autocomplete="given-name" required>
                                </div>

                                <div class="form-group">
                                    <label for="last_name" class="form-label">
                                        <i class="fas fa-id-card"></i>
                                        Last Name *
                                    </label>
                                    <input type="text" id="last_name" name="last_name" class="form-input"
                                           value="<%= user.last_name || '' %>" maxlength="50"
                                           autocomplete="family-name" required>
                                </div>

                                <div class="form-group">
                                    <label for="organization" class="form-label">
                                        <i class="fas fa-university"></i>
                                        Organization *
                                    </label>
                                    <input type="text" id="organization" name="organization" class="form-input"
                                           value="<%= user.organization || '' %>" maxlength="100"
                                           autocomplete="organization" required>
                                </div>

                                <div class="form-group">
                                    <label for="organization_type_num" class="form-label">
                                        <i class="fas fa-building"></i>
                                        Organization Type *
                                    </label>
                                    <select id="organization_type_num" name="organization_type_num" class="form-select" required>
                                        <option value="">Select the best fit</option>
                                        <% (organizationTypes || []).forEach(function(type) { %>
                                            <option
                                                value="<%= type.OrganizationTypeUniqueID %>"
                                                data-is-other="<%= type.OrganizationType === 'Other (please specify)' ? 'true' : 'false' %>"
                                                <%= user.OrganizationType_Num == type.OrganizationTypeUniqueID ? 'selected' : '' %>>
                                                <%= type.OrganizationType %>
                                            </option>
                                        <% }); %>
                                    </select>
                                </div>

                                <div id="organization-type-other-group"
                                     class="form-group <%= user.OrganizationTypeOther ? '' : 'hidden' %>">
                                    <label for="organization_type_other" class="form-label">
                                        <i class="fas fa-pen"></i>
                                        Other Organization Type
                                    </label>
                                    <input type="text" id="organization_type_other" name="organization_type_other"
                                           class="form-input" value="<%= user.OrganizationTypeOther || '' %>"
                                           maxlength="255" <%= user.OrganizationTypeOther ? '' : 'disabled' %>
                                           aria-required="false">
                                </div>

                                <div class="form-group">
                                    <label for="job_title" class="form-label">
                                        <i class="fas fa-briefcase"></i>
                                        Job / Position Title *
                                    </label>
                                    <input type="text" id="job_title" name="job_title" class="form-input"
                                           value="<%= user.job_title || '' %>" maxlength="100"
                                           autocomplete="organization-title" required>
                                </div>

                                <div class="form-group">
                                    <label for="country_num" class="form-label">
                                        <i class="fas fa-globe"></i>
                                        Country *
                                    </label>
                                    <select id="country_num" name="country_num" class="form-select" required>
                                        <option value="">Select country</option>
                                        <% (countries || []).forEach(function(country) { %>
                                            <option value="<%= country.CountryUniqueID %>"
                                                data-country-code="<%= country.ISOAlpha2 %>"
                                                <%= user.Country_Num == country.CountryUniqueID ? 'selected' : '' %>>
                                                <%= country.ISOAlpha2 === 'US' ? 'United States' : country.Country %>
                                            </option>
                                        <% }); %>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label for="state_num" class="form-label">
                                        <i class="fas fa-map-marker-alt"></i>
                                        State (United States only)
                                    </label>
                                    <select id="state_num" name="state_num" class="form-select"
                                            disabled aria-required="false">
                                        <option value="">Not applicable</option>
                                        <% (states || []).forEach(function(state) { %>
                                            <option value="<%= state.StateUniqueID %>"
                                                    data-country-num="<%= state.Country_Num %>"
                                                    <%= user.State_Num == state.StateUniqueID ? 'selected' : '' %>>
                                                <%= state.State %>
                                            </option>
                                        <% }); %>
                                    </select>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Security Section -->
                        <div class="profile-section">
                            <h2 class="section-title">
                                <i class="fas fa-lock"></i>
                                Security
                            </h2>
                            
                            <div class="form-grid">
                                <div class="form-group">
                                    <label for="current_password" class="form-label">
                                        <i class="fas fa-key"></i>
                                        Current Password
                                    </label>
                                    <input type="password" id="current_password" name="current_password" class="form-input">
                                    <small class="form-help">Required only if changing password</small>
                                </div>
                                
                                <div class="form-group">
                                    <label for="new_password" class="form-label">
                                        <i class="fas fa-lock"></i>
                                        New Password
                                    </label>
                                    <input type="password" id="new_password" name="new_password" class="form-input"
                                           minlength="8" autocomplete="new-password">
                                    <small class="form-help">
                                        Leave blank to keep the current password. New passwords require 8 characters,
                                        uppercase, lowercase, number, and special character.
                                    </small>
                                </div>
                                
                                <div class="form-group">
                                    <label for="confirm_password" class="form-label">
                                        <i class="fas fa-lock"></i>
                                        Confirm New Password
                                    </label>
                                    <input type="password" id="confirm_password" name="confirm_password" class="form-input"
                                           autocomplete="new-password">
                                </div>
                            </div>
                        </div>
                        
                        <!-- Account Information -->
                        <div class="profile-section">
                            <h2 class="section-title">
                                <i class="fas fa-info-circle"></i>
                                Account Information
                            </h2>
                            
                            <div class="account-info">
                                <% if (user.created_at) { %>
                                    <div class="info-item">
                                        <span class="info-label">Account Created:</span>
                                        <span class="info-value"><%= new Date(user.created_at).toLocaleDateString() %></span>
                                    </div>
                                <% } %>
                                <% if (user.updated_at && user.updated_at !== user.created_at) { %>
                                <div class="info-item">
                                    <span class="info-label">Last Updated:</span>
                                    <span class="info-value"><%= new Date(user.updated_at).toLocaleDateString() %></span>
                                </div>
                                <% } %>
                            </div>
                        </div>
                        
                        <!-- Form Actions -->
                        <div class="form-actions">
                            <button type="submit" class="btn-primary">
                                <i class="fas fa-save"></i>
                                Update Profile
                            </button>
                            <button type="button" class="btn-secondary" onclick="location.reload()">
                                <i class="fas fa-undo"></i>
                                Reset Changes
                            </button>
                        </div>
                    </form>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/timeout_modal') %>

<!-- Load jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- Load session timeout script -->
<script src="/js/session-timeout.js"></script>
<!-- Load fancy modal -->
<script src="/js/fancy-modal.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const organizationTypeSelect = document.getElementById('organization_type_num');
    const organizationTypeOtherGroup = document.getElementById('organization-type-other-group');
    const organizationTypeOtherInput = document.getElementById('organization_type_other');
    const countrySelect = document.getElementById('country_num');
    const stateSelect = document.getElementById('state_num');

    if (!organizationTypeSelect
        || !organizationTypeOtherGroup
        || !organizationTypeOtherInput
        || !countrySelect
        || !stateSelect) {
        return;
    }

    function updateOrganizationTypeOther() {
        const selectedOption = organizationTypeSelect.options[organizationTypeSelect.selectedIndex];
        const showOther = selectedOption && selectedOption.dataset.isOther === 'true';

        organizationTypeOtherGroup.classList.toggle('hidden', !showOther);
        organizationTypeOtherGroup.setAttribute('aria-hidden', showOther ? 'false' : 'true');
        organizationTypeOtherInput.disabled = !showOther;
        organizationTypeOtherInput.required = showOther;
        organizationTypeOtherInput.setAttribute('aria-required', showOther ? 'true' : 'false');

        if (!showOther) {
            organizationTypeOtherInput.value = '';
        }
    }

    function updateStateOptions(preserveSelection) {
        const selectedCountryId = countrySelect.value;
        const selectedCountryOption = countrySelect.options[countrySelect.selectedIndex];
        const isUnitedStates = selectedCountryOption
            && selectedCountryOption.dataset.countryCode === 'US';
        const previousStateId = preserveSelection ? stateSelect.value : '';

        Array.from(stateSelect.options).forEach(option => {
            if (!option.value) {
                option.hidden = false;
                return;
            }

            const matchesCountry = isUnitedStates
                && option.dataset.countryNum === selectedCountryId;
            option.hidden = !matchesCountry;
        });

        stateSelect.disabled = !isUnitedStates;
        stateSelect.required = isUnitedStates;
        stateSelect.setAttribute('aria-required', isUnitedStates ? 'true' : 'false');
        stateSelect.value = previousStateId
            && Array.from(stateSelect.options).some(option => option.value === previousStateId && !option.hidden)
            ? previousStateId
            : '';

        const placeholderOption = stateSelect.querySelector('option[value=""]');
        if (placeholderOption) {
            placeholderOption.textContent = isUnitedStates
                ? 'Select state'
                : 'Not applicable';
        }
    }

    organizationTypeSelect.addEventListener('change', updateOrganizationTypeOther);
    countrySelect.addEventListener('change', () => updateStateOptions(false));
    updateOrganizationTypeOther();
    updateStateOptions(true);

    // Password validation
    const newPassword = document.getElementById('new_password');
    const confirmPassword = document.getElementById('confirm_password');
    const currentPassword = document.getElementById('current_password');

    function isStrongPassword(value) {
        return value.length >= 8
            && /[a-z]/.test(value)
            && /[A-Z]/.test(value)
            && /\d/.test(value)
            && /[^A-Za-z0-9]/.test(value);
    }

    function validatePasswords() {
        if (newPassword.value || confirmPassword.value) {
            if (!isStrongPassword(newPassword.value)) {
                newPassword.setCustomValidity(
                    'Password must be at least 8 characters and include uppercase, lowercase, number, and special character.'
                );
                return false;
            } else {
                newPassword.setCustomValidity('');
            }

            if (newPassword.value !== confirmPassword.value) {
                confirmPassword.setCustomValidity('Passwords do not match');
                return false;
            } else {
                confirmPassword.setCustomValidity('');
            }
            
            if (!currentPassword.value) {
                currentPassword.setCustomValidity('Current password is required to change password');
                return false;
            } else {
                currentPassword.setCustomValidity('');
            }
        } else {
            newPassword.setCustomValidity('');
            confirmPassword.setCustomValidity('');
            currentPassword.setCustomValidity('');
        }
        return true;
    }
    
    newPassword.addEventListener('input', validatePasswords);
    confirmPassword.addEventListener('input', validatePasswords);
    currentPassword.addEventListener('input', validatePasswords);
    
    // Form submission
    document.getElementById('profile-form').addEventListener('submit', function(e) {
        if (!validatePasswords()) {
            e.preventDefault();
            return false;
        }
    });
});
</script>

</body>
</html>
