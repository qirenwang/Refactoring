<script>
// Data quality control for Page 5
(function () {
    const TOLERANCE = 0.1; // Match backend percentage validation

    function getContainer(id) {
        return document.getElementById(id);
    }

    function getInputsByNames(container, names) {
        const sel = names.map(n => `input[name="${n}"]`).join(',');
        return Array.from(container.querySelectorAll(sel));
    }

    function getInputsByPattern(container, pattern) {
        const re = new RegExp(pattern);
        // Only numeric inputs count towards the total (the "Other" description
        // text box shares the polymer name prefix).
        return Array.from(container.querySelectorAll('input[name]'))
            .filter(i => re.test(i.name) && i.type === 'number' && !i.name.endsWith('_specify'));
    }

    function groupSum(inputs) {
        let hasAny = false;
        let sum = 0;
        inputs.forEach(i => {
            const v = i.value.trim();
            if (v !== '') {
                const num = parseFloat(v);
                if (!isNaN(num)) {
                    hasAny = true;
                    sum += num;
                }
            }
        });
        return { hasAny, sum };
    }

    function validateGroups() {
        const errors = [];

        const configs = [
            { id: 'microplastics-details', groupKey: 'mp_polymer', label: 'Microplastics - Polymer type', pattern: '^mp_polymer_' },
            { id: 'fragments-details', groupKey: 'fragment_polymer', label: 'Fragments - Polymer type', pattern: '^fragment_polymer_' },

            // Active row-based percentage groups
            { id: 'micro_size_details', label: 'Microplastics - Size', detailRows: true },
            { id: 'micro_color_details', label: 'Microplastics - Color type', detailRows: true },
            { id: 'micro_opacity_details', label: 'Microplastics - Opacity', detailRows: true },
            { id: 'micro_shape_details', label: 'Microplastics - Shape', detailRows: true },
            { id: 'micro_texture_details', label: 'Microplastics - Texture', detailRows: true },
            { id: 'fragments_purpose_details', label: 'Fragments - Purpose', detailRows: true },
            { id: 'fragments_color_details', label: 'Fragments - Color type', detailRows: true },
            { id: 'fragments_form_details', label: 'Fragments - Texture', detailRows: true },
            { id: 'fragments_opacity_details', label: 'Fragments - Opacity', detailRows: true }
        ];

        configs.forEach(cfg => {
            const groupKey = cfg.groupKey || cfg.id;
            if (typeof window.shouldValidatePercentageGroup === 'function' &&
                !window.shouldValidatePercentageGroup(groupKey)) {
                return;
            }
            const container = getContainer(cfg.id);
            if (!container) return;
            const inputs = cfg.detailRows
                ? Array.from(container.querySelectorAll('.detail-percent-input'))
                : (cfg.names ? getInputsByNames(container, cfg.names)
                             : getInputsByPattern(container, cfg.pattern));
            if (!inputs.length) return;
            const { hasAny, sum } = groupSum(inputs);
            if (!hasAny) return; // Section empty -> OK
            if (Math.abs(sum - 100) > TOLERANCE) {
                errors.push(`${cfg.label}: totals ${sum.toFixed(2)}% (must equal 100% or leave all blank)`);
            }
        });

        // The "Other" polymer percentage must be described in the box under it
        // (and a description without an Other percentage is meaningless).
        [
            { prefix: 'mp_polymer_', groupKey: 'mp_polymer', label: 'Microplastics - Polymer type' },
            { prefix: 'fragment_polymer_', groupKey: 'fragment_polymer', label: 'Fragments - Polymer type' }
        ].forEach(cfg => {
            if (typeof window.shouldValidatePercentageGroup === 'function' &&
                !window.shouldValidatePercentageGroup(cfg.groupKey)) {
                return;
            }
            const percentInput = document.querySelector(`input[name="${cfg.prefix}other"]`);
            const specifyInput = document.querySelector(`input[name="${cfg.prefix}other_specify"]`);
            if (!percentInput || !specifyInput) return;
            const otherPercent = parseFloat(percentInput.value);
            const description = specifyInput.value.trim();
            if (otherPercent > 0 && !description) {
                errors.push(`${cfg.label}: please describe the "Other" polymer(s) in the box under the Other percentage`);
            } else if (description && !(otherPercent > 0)) {
                errors.push(`${cfg.label}: an "Other" description was entered but the Other percentage is blank or 0`);
            }
        });

        return errors;
    }

    // Intercept the Continue click for page 5 and show issues, without breaking navigation on success
    document.addEventListener('click', function (e) {
        const btn = e.target && e.target.closest('#form-page5 .btn-continue[data-next="6"]');
        if (!btn) return;
        const errors = validateGroups();
        if (errors.length) {
            e.preventDefault();
            e.stopPropagation();
            if (typeof e.stopImmediatePropagation === 'function') e.stopImmediatePropagation();
            alert('Please review your percentage entries:\n\n' + errors.map((er, i) => `${i+1}. ${er}`).join('\n'));
        }
    }, true);
})();
</script>
